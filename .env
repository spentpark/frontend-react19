# Variables para `npm run dev` (backend nativo con CORS). En Docker estas URLs
# se sobrescriben con build args relativos (`/api` y `/news-api`) y Nginx hace
# de proxy inverso bajo el mismo origen, así que la app funciona desde cualquier
# IP sin tocar este archivo (ver Dockerfile y docker-compose.yml).
#
# API de catálogo en Python (FastAPI). Todas las rutas viven bajo /api y el
# servidor escucha en el puerto 7000 (el backend Node usa 3000).
VITE_API_URL=http://localhost:7000/api

# Servicio de noticias (rss-game-node) en el puerto 3001. Comparte el JWT con el
# backend del catálogo (mismo secreto, issuer y audience), así que el token
# obtenido para el catálogo también vale aquí.
VITE_NEWS_API_URL=http://localhost:3001/api

# Credenciales de desarrollo con las que el frontend pide el JWT a
# `POST /api/auth/login` (compartidas con backend-node20/rss-game-node).
VITE_API_USERNAME=admin
VITE_API_PASSWORD=Dev-aekiu4-9mHsG
